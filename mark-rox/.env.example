# Node.js 24+. Copy to .env. Never publish .env or data/.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://adminpro.localhost:3000
DATA_DIR=./data
# Run npm run admin:setup to create a username + hashed password.
# Optional one-time unattended bootstrap (avoid shell history; remove after setup):
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Enable only after configuring legal identity/contact and checking the catalogue.
INQUIRIES_ENABLED=0
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_RETENTION_DAYS=180

# Telegram BotFather token; server-side only. No Telegram connection by default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend. Use a verified sender domain. Server-side only.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Set to 1 only behind a trusted reverse proxy that REPLACES X-Forwarded-For.
TRUST_PROXY=0

# PRODUCTION: set NODE_ENV=production and real, separate HTTPS origins, e.g.
# PUBLIC_URL=https://your-domain.example
# ADMIN_URL=https://adminpro.your-domain.example
# HOST=127.0.0.1 (or 0.0.0.0 inside an isolated container)
